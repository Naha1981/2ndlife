# ============================================
# 2NDLIFE L1 PRODUCTION SECRETS MATRIX
# Copy to .env.local — NEVER commit real values.
# ============================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE
CLERK_SECRET_KEY=sk_live_REPLACE

# --- WhatsApp Platform (Custom Baileys Operator, ADR-014) ---
WHATSAPP_PLATFORM_URL=https://your-operator.onrender.com
WEBHOOK_HMAC_SECRET=REPLACE_openssl_rand_hex_32

# --- Cron (Vercel auto-sends this as Bearer on cron routes) ---
CRON_SECRET=REPLACE_openssl_rand_hex_32

# --- Payments (PayFast) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# --- AI ---
OPENAI_API_KEY=sk-REPLACE

# --- Seeding gate (MUST be false in production) ---
ALLOW_SEEDING=false
