// 2ndLife — Prisma schema (SQLite)
// Multi-tenant Revenue Recovery Intelligence platform.
// Every business table has tenant_id; isolation enforced in the data-access layer.
// SQLite doesn't support enums natively, so status fields use String with
// documented allowed values enforced at the service layer (Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Core tenant tables
// ─────────────────────────────────────────────────────────────

model Tenant {
  whatsAppAccountId String?
  id        String   @id @default(cuid())
  name      String
  industry  String   @default("general") // funeral-insurance, subscriptions, financial-services, education, healthcare, retail, b2b-services, general
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  customers       Customer[]
  campaigns       Campaign[]
  conversations   Conversation[]
  payments        Payment[]
  auditLogs       AuditLog[]
  imports         Import[]
  opportunities   RecoveryOpportunity[]
  customerContacts CustomerContact[]
  messages        ConversationMessage[]
  // Revenue OS — new engine relations
  demandSignals   DemandSignal[]
  socialQuestions SocialQuestion[]
  contentBriefs   ContentBrief[]
  bookings        Booking[]
  loyaltyAccounts LoyaltyAccount[]
  // LiveSignal Phase A
  liveRooms       LiveRoom[]
  liveSignals     LiveSignal[]
  liveLeads       LiveLead[]
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Customer domain
// ─────────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  externalId    String?
  firstName     String?
  lastName      String?
  status        String   @default("active") // active | lapsed | failed_debit | dormant | at_risk
  lifetimeValue Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts     CustomerContact[]
  opportunities RecoveryOpportunity[]
  conversations Conversation[]

  @@index([tenantId])
}

model CustomerContact {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String
  type           String // phone | email
  value          String
  isPrimary      Boolean  @default(false)
  whatsappValid  Boolean  @default(false)
  optOut         Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

// ─────────────────────────────────────────────────────────────
// Recovery opportunity (core domain object)
// ─────────────────────────────────────────────────────────────

model RecoveryOpportunity {
  id                 String   @id @default(cuid())
  tenantId           String
  customerId         String
  sourceRecordId     String?
  category           String // lapsed_customer | stale_quote | unpaid_invoice | failed_payment | missed_renewal | dormant_customer | at_risk_recurring | abandoned_cart
  score              Int      @default(0) // 0–100
  estimatedValue     Float?
  actualValue        Float?
  status             String   @default("new") // new | qualified | queued | contacted | engaged | negotiating | converted | recovered | declined | unresponsive | failed | suppressed
  reason             String? // JSON-serialized { reasons: [], risks: [] }
  recommendedAction  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  payments      Payment[]

  @@index([tenantId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Imports
// ─────────────────────────────────────────────────────────────

model Import {
  id           String   @id @default(cuid())
  tenantId     String
  filename     String
  totalRows    Int      @default(0)
  validRows    Int      @default(0)
  errorRows    Int      @default(0)
  duplicates   Int      @default(0)
  status       String   @default("pending") // pending | processing | completed | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Campaigns
// ─────────────────────────────────────────────────────────────

model Campaign {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  audienceFilters String? // JSON: { inactiveDaysGte, minScore, whatsappValid, excludeSuppressed }
  channel        String   @default("whatsapp")
  minScore       Int      @default(0)
  status         String   @default("draft") // draft | dry_run | active | paused | completed | stopped
  config         String?  // JSON: { sendCapPerHour, businessHours, retries, offerBandId, escalateAfterObjections, stopOptOutRatePct }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Conversations & messages
// ─────────────────────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String
  opportunityId  String?
  campaignId     String?
  channel        String   @default("whatsapp")
  status         String   @default("open") // open | engaged | awaiting_human | recovered | opted_out | closed
  intent         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity  RecoveryOpportunity?  @relation(fields: [opportunityId], references: [id])
  campaign     Campaign?             @relation(fields: [campaignId], references: [id])
  messages     ConversationMessage[]

  @@index([tenantId])
  @@index([customerId])
}

model ConversationMessage {
  id                String   @id @default(cuid())
  tenantId          String
  conversationId    String
  role              String // ai | customer | system
  body              String
  kind              String  @default("text") // text | payment_request | payment_confirmed | opt_out | escalation
  amount            Float?
  metadata          String? // JSON
  providerMessageId String? // ID from Evolution/Mock adapter (outbound only)
  deliveryStatus    String  @default("sent") // sent | delivered | read | failed | queued
  createdAt         DateTime @default(now())

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
}

// ─────────────────────────────────────────────────────────────
// Webhook events (audit + idempotency)
// ─────────────────────────────────────────────────────────────

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    // evolution | mock
  providerEventId String    @unique
  tenantId        String?
  raw             String    // JSON-serialized payload
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([providerEventId])
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id               String   @id @default(cuid())
  tenantId         String
  opportunityId    String?
  provider         String // ozow | payfast | stripe
  providerReference String
  amount           Float
  currency         String   @default("ZAR")
  status           String   @default("pending") // pending | confirmed | failed | refunded
  webhookPayload   String?  // JSON
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())
  confirmedAt      DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity RecoveryOpportunity? @relation(fields: [opportunityId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Audit log (append-only)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String? // JSON
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entityType, entityId])
}

// ═══════════════════════════════════════════════════════════════
// 2ndLife Revenue OS — New Engine Models (PLANNED)
// These models support the 8-Engine Revenue OS architecture.
// Activated in the Marketing Brain phase — schema is ready for db push.
// ═══════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────
// Demand Radar — detects what the market wants
// ─────────────────────────────────────────────────────────────

model DemandSignal {
  id               String   @id @default(cuid())
  tenantId         String
  source           String   // 'search', 'social', 'competitor', 'faq'
  topic            String   // e.g., "teeth whitening cost Sandton"
  frequency        Int      @default(1)
  commercialIntent Int      @default(0) // 0-100 score
  status           String   @default("new") // 'new', 'opportunity', 'briefed', 'published'
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @updatedAt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions SocialQuestion[]
  briefs    ContentBrief[]

  @@index([tenantId])
  @@index([status])
}

model SocialQuestion {
  id             String   @id @default(cuid())
  tenantId       String
  signalId       String
  platform       String   // 'tiktok', 'instagram', 'google_reviews'
  originalText   String
  normalizedText String   // clustered canonical question
  occurrences    Int      @default(1)
  createdAt      DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signal DemandSignal   @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([signalId])
}

model ContentBrief {
  id             String   @id @default(cuid())
  tenantId       String
  signalId       String
  objective      String   // 'lead_gen', 'education', 'objection_handling'
  targetAudience String
  hook           String
  cta            String   // e.g., "WhatsApp for a free quote"
  formats        String   // JSON array: '["reel", "carousel", "seo_article"]'
  approvalStatus String   @default("draft") // 'draft', 'approved', 'published'
  createdAt      DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signal DemandSignal   @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([signalId])
}

// ─────────────────────────────────────────────────────────────
// Bookings — for the Conversion Engine
// ─────────────────────────────────────────────────────────────

model Booking {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String
  service      String
  scheduledAt  DateTime
  status       String    @default("pending") // 'pending', 'confirmed', 'completed', 'no_show', 'cancelled'
  price        Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Loyalty Accounts — for the Retention Engine
// ─────────────────────────────────────────────────────────────

model LoyaltyAccount {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  points      Int      @default(0)
  tier        String   @default("bronze") // 'bronze', 'silver', 'gold', 'platinum'
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@unique([tenantId, customerId])
}

// ─────────────────────────────────────────────────────────────
// LiveSignal Phase A — live visitor intent intelligence
// Raw transcripts are NEVER persisted. Only classified excerpts
// (≤120 chars, PII-stripped) are written to LiveSignal.excerpt.
// ─────────────────────────────────────────────────────────────

model LiveRoom {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  mode      String   @default("private") // private | community (community blocked until Phase B)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signals LiveSignal[]
  leads   LiveLead[]

  @@index([tenantId])
}

model LiveSignal {
  id              String   @id @default(cuid())
  tenantId        String
  roomId          String
  // 8 categories: price | availability | urgency | financing |
  //   value_objection | social_validation | logistics | purchase_intent
  category        String
  excerpt         String   // ≤120 chars, PII-stripped — RAW TRANSCRIPT NEVER STORED
  promotedToRadar Boolean  @default(false)
  occurrences     Int      @default(1)
  createdAt       DateTime @default(now())

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
  @@index([category])
}

model LiveLead {
  id            String    @id @default(cuid())
  tenantId      String
  roomId        String
  sessionId     String    @unique  // anonymous visitor token — no PII
  signalIds     String    @default("[]") // JSON array of LiveSignal ids
  handoffSent   Boolean   @default(false)
  handoffAt     DateTime?
  // Proof consent gate — publishing blocked until 'granted'
  consentStatus String    @default("pending") // pending | granted | denied
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([roomId])
}

model OutboxMessage {
  id          String   @id @default(cuid())
  accountId   String
  to          String
  text        String?
  media       Json?
  status      String   @default("queued") // queued | sending | delivered | failed
  attempts    Int      @default(0)
  deliveryId  String?
  traceId     String?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deliveredAt DateTime?
  deadAt      DateTime?

  @@index([status, createdAt])
  @@index([accountId, createdAt])
}

model PlatformJob {
  id          String   @id @default(cuid())
  appId       String
  tenantId    String
  messageId   String
  payload     Json
  status      String   @default("pending") // pending | running | done | failed
  attempts    Int      @default(0)
  runAt       DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAt])
  @@index([messageId])
}
